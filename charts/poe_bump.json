{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 30,
    "bottom": 30
  },
  "background": "transparent",
  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/soe_bump.csv",
    "format": { "type": "csv" }
  },

  "transform": [
    {
      "filter": "toDate(datum.ym) >= toDate('2020-12-01') && toDate(datum.ym) <= toDate('2023-12-31')"
    },

    {
      "calculate": "datum.rank <= 5 ? datum.rank : null",
      "as": "display_rank"
    }
  ],

  "encoding": {
    "x": {
      "field": "ym",
      "type": "temporal",
      "title": null,
      "axis": {
        "tickCount": { "interval": "month", "step": 6 },
        "grid": false,
        "labelExpr": "[timeFormat(datum.value, '%b') == 'Jan' ? timeFormat(datum.value, '%b %Y') : timeFormat(datum.value, '%b')]",
        "labelPadding": 15
      }
    },
    "y": {
      "field": "display_rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": { "reverse": true, "domain": [1, 5] },
      "axis": {
        "tickMinStep": 1,
        "format": "d",
        "grid": false,
        "domain": false,
        "titlePadding": 10,
        "labelPadding": 15,
        "labelFontWeight": "bold"
      }
    },
    "color": {
      "field": "soe",
      "type": "nominal",
      "title": "State of Entry",
      "legend": null,
      "scale": {
        "domain": [
          "Johor",
          "Selangor",
          "Sarawak",
          "Pulau Pinang",
          "Kedah",
          "Perlis"
        ],
        "range": [
          "#b8a500",
          "#439400",
          "#00948f",
          "#5a8ed6",
          "#c866d1",
          "#6929a6"
        ]
      }
    },
    "tooltip": [
      { "field": "soe", "type": "nominal", "title": "State" },
      {
        "field": "ym",
        "type": "temporal",
        "title": "Month",
        "format": "%B %Y"
      },
      {
        "field": "arrivals",
        "type": "quantitative",
        "title": "Arrivals",
        "format": ","
      },
      { "field": "rank", "type": "ordinal", "title": "Rank" }
    ]
  },

  "layer": [
    {
      "transform": [
        { "calculate": "toDate('2022-04-01')", "as": "refDate" }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#596172",
        "strokeWidth": 3,
        "strokeDash": [5, 8]
      },
      "encoding": {
        "x": { "field": "refDate", "type": "temporal" },
        "y": { "datum": 0.75 },
        "y2": { "datum": 5.25 }
      }
    },
    {
      "transform": [
        { "calculate": "toDate('2022-04-01')", "as": "refDate" }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fill": "#596172",
        "align": "left",
        "baseline": "bottom",
        "dx": 10,
        "dy": -22
      },
      "encoding": {
        "x": { "field": "refDate", "type": "temporal" },
        "y": { "datum": 1 },
        "text": { "value": "Borders Reopened" }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 16,
        "opacity": 0.4,
        "interpolate": "monotone",
        "strokeCap": "round"
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 5,
        "interpolate": "monotone",
        "strokeCap": "round"
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "white",
        "size": 120
      }
    },
    {
      "transform": [
        { "filter": "datum.display_rank != null" },
        {
          "window": [{ "op": "rank", "as": "order" }],
          "sort": [{ "field": "ym", "order": "descending" }],
          "groupby": ["soe"]
        },
        { "filter": "datum.order == 1" }
      ],
      "layer": [
        {
          "transform": [{ "filter": "datum.soe !== 'Perlis'" }],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 15,
            "fontSize": 16,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": { "field": "soe" }
          }
        },
        {
          "transform": [{ "filter": "datum.soe === 'Perlis'" }],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": -5,
            "dy": -20,
            "fontSize": 16,
            "fontWeight": "bold"
          },
          "encoding": {
            "text": { "field": "soe" }
          }
        }
      ]
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
