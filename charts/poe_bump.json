{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "padding": { "left": 0, "right": 0, "top": 10, "bottom": 10 },
  "background": "transparent",
  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/soe_bump.csv",
    "format": { "type": "csv" }
  },

  "transform": [
    {
      "filter": "toDate(datum.ym) >= toDate('2020-12-01') && toDate(datum.ym) <= toDate('2023-12-31')"
    },

    {
      "calculate": "datum.rank <= 5 ? datum.rank : null",
      "as": "display_rank"
    }
  ],

  "encoding": {
    "x": {
      "field": "ym",
      "type": "temporal",
      "title": null,
      "axis": {
        "tickCount": { "interval": "month", "step": 6 },
        "grid": false,
        "labelExpr": "[timeFormat(datum.value, '%b') == 'Jan' ? timeFormat(datum.value, '%b %Y') : timeFormat(datum.value, '%b')]"
      }
    },
    "y": {
      "field": "display_rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": { "reverse": true, "domain": [1, 5] },
      "axis": { "tickMinStep": 1, "format": "d", "grid": false }
    },
    "color": {
      "field": "soe",
      "type": "nominal",
      "title": "State of Entry",
      "legend": null,
      "scale": {
        "domain": [
          "Johor",
          "Selangor",
          "Sarawak",
          "Pulau Pinang",
          "Kedah",
          "Perlis"
        ],
        "range": [
          "#bf8f00",
          "#439400",
          "#00948f",
          "#6da3ed",
          "#da99e0",
          "#432263"
        ]
      }
    },
    "tooltip": [
      { "field": "soe", "type": "nominal", "title": "State" },
      {
        "field": "ym",
        "type": "temporal",
        "title": "Month",
        "format": "%B %Y"
      },
      {
        "field": "arrivals",
        "type": "quantitative",
        "title": "Arrivals",
        "format": ","
      },
      { "field": "rank", "type": "ordinal", "title": "Rank" }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 10,
        "opacity": 0.5,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "interpolate": "monotone"
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "white",
        "size": 60
      }
    },
    {
      "transform": [
        { "filter": "datum.display_rank != null" },
        {
          "window": [{ "op": "rank", "as": "order" }],
          "sort": [{ "field": "ym", "order": "descending" }],
          "groupby": ["soe"]
        },
        { "filter": "datum.order == 1" }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 16,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": { "field": "soe" }
      }
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
