{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 640,
  "padding": { "top": 20, "bottom": 50, "left": 0, "right": 0 },
  "background": "transparent",
  "params": [{ "name": "scatterYear", "value": 2023 }],
  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/arrivals_soe.csv",
    "format": {
      "type": "csv",
      "parse": { "year": "number", "arrivals": "number" }
    }
  },
  "transform": [
    { "filter": "datum.year == scatterYear" },
    {
      "aggregate": [{ "op": "sum", "field": "arrivals", "as": "arrivals" }],
      "groupby": ["soe", "year"]
    },
    {
      "calculate": "datum.soe + '|' + toString(scatterYear)",
      "as": "join_key"
    },
    {
      "lookup": "join_key",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/tourism_state_agg.csv",
          "format": {
            "type": "csv",
            "parse": { "year": "number", "gdp_p5": "number" }
          }
        },
        "key": "join_key",
        "fields": ["gdp_p5", "state"]
      }
    },
    { "filter": "datum.gdp_p5 != null && datum.arrivals > 0" },
    { "filter": "datum.state != 'Supra'" },
    {
      "joinaggregate": [
        { "op": "sum", "field": "arrivals", "as": "TotalArrivals" },
        { "op": "sum", "field": "gdp_p5", "as": "TotalRevenue" }
      ]
    },
    {
      "calculate": "datum.arrivals / datum.TotalArrivals",
      "as": "arrivals_share"
    },
    { "calculate": "datum.gdp_p5 / datum.TotalRevenue", "as": "revenue_share" },
    {
      "calculate": "datum.revenue_share / datum.arrivals_share",
      "as": "rev_per_arrival_ratio"
    },
    {
      "calculate": "(datum.gdp_p5 * 1000000) / datum.arrivals",
      "as": "StateRevenuePerArrival_RM"
    },
    { "filter": "datum.arrivals_share >= 0.015" }
  ],
  "layer": [
    {
      "data": {
        "values": [
          { "x": 0, "y": 0 },
          { "x": 0.65, "y": 0.65 }
        ]
      },
      "mark": {
        "type": "line",
        "strokeDash": [4, 4],
        "opacity": 0.6,
        "color": "black"
      },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "field": "y", "type": "quantitative" }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "arrivals_share",
          "type": "quantitative",
          "axis": {
            "title": "Share of Total Arrivals",
            "format": ".0%",
            "tickCount": 13,
            "titlePadding": 15
          },
          "scale": { "nice": true }
        },
        "y": {
          "field": "revenue_share",
          "type": "quantitative",
          "axis": {
            "title": "Share of Total Tourism Revenue",
            "format": ".0%",
            "tickCount": 13,
            "titlePadding": 15
          },
          "scale": { "nice": true }
        },
        "size": {
          "field": "gdp_p5",
          "type": "quantitative",
          "title": ["State Tourism Revenue", "(RM mil)"],
          "legend": {
            "format": ",.0f",
            "titleLimit": 0,
            "titlePadding": 15,
            "labelOffset": 5,
            "symbolFillColor": "#a3a3a3",
            "padding": 20
          },
          "scale": { "range": [50, 1200] }
        },
        "color": {
          "field": "rev_per_arrival_ratio",
          "type": "quantitative",
          "title": "Revenue / Arrival Ratio",
          "legend": {
            "format": ".1f",
            "titleLimit": 0,
            "titlePadding": 15,
            "gradientThickness": 25,
            "labelOffset": 15,
            "padding": 20
          },
          "scale": { "scheme": "viridis", "domain": [0, 2.5] }
        },
        "tooltip": [
          { "field": "soe", "type": "nominal", "title": "State" },
          { "field": "year", "type": "quantitative", "title": "Year" },
          {
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ",.0f"
          },
          {
            "field": "gdp_p5",
            "type": "quantitative",
            "title": "State Tourism Revenue (RM mil)",
            "format": ",.2f"
          },
          {
            "field": "revenue_share",
            "type": "quantitative",
            "title": "Share of Total Tourism Revenue",
            "format": ".2%"
          },
          {
            "field": "arrivals_share",
            "type": "quantitative",
            "title": "Share of Total Arrivals",
            "format": ".2%"
          },
          {
            "field": "rev_per_arrival_ratio",
            "type": "quantitative",
            "title": "Revenue / Arrivals Share Ratio",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "layer": [
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "rect",
            "cornerRadius": 5,
            "color": "#f8fdff",
            "opacity": 0.9,
            "stroke": "#ddd",
            "strokeWidth": 1
          },
          "encoding": {
            "x": { "value": 20 },
            "y": { "value": 170 },
            "x2": { "value": 432 },
            "y2": { "value": 252 }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16
          },
          "encoding": {
            "x": { "value": 40 },
            "y": { "value": 190 },
            "text": { "value": "Points above the line, like" }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16,
            "fontWeight": "bold"
          },
          "encoding": {
            "x": { "value": 225 },
            "y": { "value": 190 },
            "text": { "value": "Selangor," },
            "color": { "value": "#439400" }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16
          },
          "encoding": {
            "x": { "value": 40 },
            "y": { "value": 215 },
            "text": {
              "value": "have a higher share of tourism revenue than arrivals."
            }
          }
        },

        {
          "data": { "values": [{}] },
          "mark": {
            "type": "rect",
            "cornerRadius": 5,
            "color": "#f8fdff",
            "opacity": 0.9,
            "stroke": "#ddd",
            "strokeWidth": 1
          },
          "encoding": {
            "x": { "value": 230 },
            "y": { "value": 480 },
            "x2": { "value": 600 },
            "y2": { "value": 562 }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16,
            "fontWeight": "bold"
          },
          "encoding": {
            "x": { "value": 250 },
            "y": { "value": 500 },
            "text": { "value": "Johor" },
            "color": { "value": "#b8a500" }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16
          },
          "encoding": {
            "x": { "value": 300 },
            "y": { "value": 500 },
            "text": { "value": "has by far the highest share of arrivals," }
          }
        },
        {
          "data": { "values": [{}] },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 16
          },
          "encoding": {
            "x": { "value": 250 },
            "y": { "value": 525 },
            "text": {
              "value": "but it has a very low revenue / arrival ratio."
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
