{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 560,
  "background": "transparent",
  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/arrivals_record.csv"
  },

  "params": [
    {
      "name": "Year",
      "value": 2023,
      "bind": { "input": "range", "min": 2020, "max": 2023, "step": 1 }
    },
    {
      "name": "TopN",
      "value": 6
    },
    {
      "name": "Region",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "ASEAN",
          "East Asia",
          "South Asia",
          "Europe",
          "Middle East",
          "Pacific",
          "Americas",
          "Africa",
          "Others"
        ]
      }
    }
  ],

  "transform": [
    {
      "lookup": "poe",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/points_of_entry.csv"
        },
        "key": "poe",
        "fields": ["type"]
      }
    },

    {
      "lookup": "country",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/country_region.csv"
        },
        "key": "country",
        "fields": ["region"]
      }
    },

    {
      "calculate": "isValid(datum.region) ? datum.region : 'Others'",
      "as": "region_safe"
    },

    { "calculate": "year(toDate(datum.date))", "as": "yr" },
    { "filter": "datum.yr === Year" },
    { "filter": "Region === 'All' || datum.region_safe === Region" },

    {
      "aggregate": [{ "op": "sum", "field": "arrivals", "as": "arrivals_sum" }],
      "groupby": ["country", "type", "region_safe"]
    },

    {
      "joinaggregate": [
        { "op": "sum", "field": "arrivals_sum", "as": "country_total" }
      ],
      "groupby": ["country"]
    },

    {
      "window": [{ "op": "dense_rank", "as": "rk" }],
      "sort": [{ "field": "country_total", "order": "descending" }]
    },

    { "filter": "datum.rk <= TopN" },
    {
      "lookup": "country",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/country_codes.csv"
        },
        "key": "iso3",
        "fields": ["country_common"]
      },
      "as": ["country_name"]
    }
  ],

  "mark": { "type": "bar" },
  "encoding": {
    "x": {
      "field": "country_name",
      "type": "nominal",
      "sort": "-y",
      "title": "Country",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "aggregate": "sum",
      "field": "arrivals_sum",
      "type": "quantitative",
      "title": "Arrivals (selected year)"
    },
    "color": { 
      "field": "type", 
      "type": "nominal", 
      "title": "Mode",
      "scale": {
        "domain": ["Land", "Air", "Sea"],
        "range": ["#E69F00", "#3da7d4", "#009E73"]
      }
    },
    "tooltip": [
      { "field": "country_name", "title": "Country" },
      { "field": "region_safe", "title": "Region" },
      {
        "aggregate": "sum",
        "field": "arrivals_sum",
        "title": "Total arrivals",
        "format": ","
      },
      { "field": "type", "title": "Segment mode" },
      { "field": "arrivals_sum", "title": "Segment arrivals", "format": "," }
    ]
  },

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
