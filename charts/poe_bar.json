{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 points of entry (POE) by total arrivals for a selected year; bars colored by entry type (Land/Sea/Air).",
  "width": "container",
  "height": 440,
  "padding": {
    "top": 40,
    "bottom": 10,
    "left": 0,
    "right": 0
  },
  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/poe_without_country.csv",
    "format": { "type": "csv" }
  },

  "params": [
    {
      "name": "Year",
      "value": 2023
    }
  ],

  "transform": [
    { "calculate": "year(toDate(datum.date))", "as": "Year" },

    {
      "aggregate": [
        { "op": "sum", "field": "arrivals", "as": "TotalArrivals" }
      ],
      "groupby": ["Year", "poe"]
    },

    {
      "lookup": "poe",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/points_of_entry.csv",
          "format": { "type": "csv" }
        },
        "key": "poe",
        "fields": ["type"]
      }
    },

    { "filter": "datum.Year == Year" },

    {
      "window": [{ "op": "rank", "as": "rank" }],
      "sort": [{ "field": "TotalArrivals", "order": "descending" }],
      "groupby": ["Year"]
    },

    { "filter": "datum.rank <= 10" }
  ],

  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "y": {
          "field": "poe",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "titlePadding": 25,
            "labelLimit": 1000,
            "labelPadding": 10
          }
        },
        "x": {
          "field": "TotalArrivals",
          "type": "quantitative",
          "title": "Arrivals",
          "axis": {
            "format": "~s",
            "tickCount": 10,
            "titlePadding": 15
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": "Mode of Entry",
          "scale": {
            "domain": ["Land", "Air", "Sea"],
            "range": ["#E69F00", "#3da7d4", "#009E73"]
          },
          "legend": {
            "orient": "none",
            "legendX": 630,
            "legendY": 310,
            "symbolSize": 400,
            "symbolType": "circle",
            "rowPadding": 5
          }
        },

        "tooltip": [
          { "field": "poe", "type": "nominal", "title": "Point of Entry" },
          { "field": "type", "type": "nominal", "title": "Mode" },
          { "field": "Year", "type": "quantitative" },
          {
            "field": "TotalArrivals",
            "type": "quantitative",
            "format": ",",
            "title": "Arrivals"
          }
        ]
      }
    },

    {
      "transform": [
        { "filter": "datum.rank == 1" },
        {
          "calculate": "'Top Point of Entry (' + toString(Year) + ')'",
          "as": "AnnTitle"
        },
        {
          "calculate": "format(datum.TotalArrivals, ',.0f') + ' arrivals • ' + datum.type",
          "as": "AnnSub"
        },
        {
          "calculate": "datum.poe == 'Bangunan Sultan Iskandar' ? 'It is the busiest land crossing linking Malaysia and Singapore.' : 'It is main land connection between Malaysia and Thailand.'",
          "as": "descLine"
        }
      ],

      "layer": [
        {
          "mark": {
            "type": "rect",
            "cornerRadius": 10,
            "color": "white",
            "opacity": 0.95,
            "stroke": "#ddd"
          },
          "encoding": {
            "x": { "value": 440 },
            "y": { "value": 60 },
            "x2": { "value": 800 },
            "y2": { "value": 165 }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "normal",
            "align": "left",
            "baseline": "top"
          },
          "encoding": {
            "x": { "value": 460 },
            "y": { "value": 75 },
            "text": { "field": "AnnTitle" }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 14,
            "fontWeight": "bold",
            "align": "left",
            "baseline": "top",
            "fill": "#9c6b00bb"
          },
          "encoding": {
            "x": { "value": 460 },
            "y": { "value": 97 },
            "text": { "field": "poe" }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "normal",
            "align": "left",
            "baseline": "top"
          },
          "encoding": {
            "x": { "value": 460 },
            "y": { "value": 120 },
            "text": { "field": "AnnSub" }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": "normal",
            "align": "left",
            "baseline": "top"
          },
          "encoding": {
            "x": { "value": 460 },
            "y": { "value": 138 },
            "text": { "field": "descLine" }
          }
        }
      ]
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
