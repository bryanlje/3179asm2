{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Monthly Arrivals (Year x Month Heatmap)",
    "anchor": "start"
  },
  "width": 700,
  "height": 350,
  "background": "white",
  "padding": 10,

  "data": {
    "url": "data/arrivals_soe_monthly_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "utc:'%Y-%m-%d'",
        "arrivals": "number",
        "arrivals_male": "number",
        "arrivals_female": "number"
      }
    }
  },

  "params": [
    {
      "name": "Gender",
      "value": "All",
      "bind": { "input": "select", "options": ["All", "Male", "Female"] }
    },
    {
      "name": "SOE",
      "value": "",
      "bind": { "input": "text", "placeholder": "Enter State (e.g., Johor)" }
    }
  ],

  "transform": [
    {
      "filter": "datum.date >= toDate('2020-01-01') && datum.date <= toDate('2024-12-31')"
    },
    {
      "calculate": "Gender === 'Male' ? datum.arrivals_male : (Gender === 'Female' ? datum.arrivals_female : datum.arrivals)",
      "as": "arrivals_sel"
    },
    {
      "filter": "SOE === '' || datum.soe === SOE"
    }
  ],

  "mark": {
    "type": "rect",
    "stroke": "#f0f0f0",
    "strokeWidth": 1,
    "cornerRadius": 2
  },

  "encoding": {
    "y": {
      "timeUnit": "year",
      "field": "date",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 12,
        "titleFontSize": 12
      }
    },
    "x": {
      "timeUnit": "month",
      "field": "date",
      "type": "ordinal",
      "title": "Month",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titleFontSize": 12,
        "format": "%b",
        "ticks": false,
        "domain": false
      },
      "scale": { "paddingInner": 0.05, "paddingOuter": 0.05 }
    },
    "color": {
      "aggregate": "sum",
      "field": "arrivals_sel",
      "type": "quantitative",
      "title": "Arrivals",
      "scale": { "scheme": "yelloworangered" },
      "legend": {
        "title": "Arrivals",
        "format": "~s",
        "gradientLength": 180,
        "orient": "right",
        "labelFontSize": 12,
        "titleFontSize": 12
      }
    },
    "tooltip": [
      {
        "timeUnit": "yearmonth",
        "field": "date",
        "type": "temporal",
        "title": "Month"
      },
      {
        "aggregate": "sum",
        "field": "arrivals_sel",
        "type": "quantitative",
        "title": "Arrivals",
        "format": ","
      }
    ]
  },

  "config": {
    "view": { "stroke": null },
    "axis": { "labelColor": "black", "titleColor": "black" },
    "legend": { "labelColor": "black", "titleColor": "black" },
    "title": { "color": "black", "fontSize": 18 }
  }
}
