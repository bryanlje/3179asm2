{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "background": "transparent",
  "padding": {
    "left": 0,
    "right": 0,
    "top": 10,
    "bottom": 10
  },

  "data": {
    "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/arrivals_soe_monthly_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "date": "utc:'%Y-%m-%d'",
        "arrivals": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.date >= toDate('2020-01-01') && datum.date <= toDate('2024-12-31')"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f0f0f0",
        "strokeWidth": 1,
        "cornerRadius": 2
      },

      "encoding": {
        "y": {
          "timeUnit": "year",
          "field": "date",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "ticks": false,
            "domain": false,
            "titlePadding": 15
          },
          "scale": {
            "paddingInner": 0.05
          }
        },

        "x": {
          "timeUnit": "month",
          "field": "date",
          "type": "ordinal",
          "title": "Month",
          "axis": {
            "labelAngle": 0,
            "format": "%b",
            "ticks": false,
            "domain": false,
            "titlePadding": 15
          },
          "scale": {
            "paddingInner": 0.05,
            "paddingOuter": 0.05
          }
        },

        "color": {
          "aggregate": "sum",
          "field": "arrivals",
          "type": "quantitative",
          "title": "Arrivals",
          "scale": {
            "scheme": "tealblues"
          },
          "legend": {
            "title": "Arrivals",
            "format": "~s",
            "gradientLength": 180,
            "orient": "right"
          }
        },

        "tooltip": [
          {
            "timeUnit": "yearmonth",
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "aggregate": "sum",
            "field": "arrivals",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
