{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "padding": { "left": 0, "right": 0, "top": 10, "bottom": 10 },
  "background": "transparent",
  "projection": { "type": "mercator" },
  "view": { "stroke": "transparent" },

  "params": [
    { "name": "Year", "value": 2023 }
  ],

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/output.json",
        "format": { "type": "topojson", "feature": "ne_110m_graticules_1" }
      },
      "mark": { "type": "geoshape", "stroke": "#d1d1d1", "strokeWidth": 0.5 }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/output.json",
        "format": { "type": "topojson", "feature": "my" }
      },
      "mark": { "type": "geoshape", "fill": "#e9e9e9", "stroke": "#a9a9a9" }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/poe_without_country.csv",
        "format": { "type": "csv", "parse": { "date": "date" } }
      },
      "transform": [
          { "calculate": "year(toDate(datum.date))", "as": "yr" },
          { "filter": "datum.yr == Year" },
          {
            "lookup": "poe",
            "from": {
              "data": { "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/points_of_entry.csv" },
              "key": "poe",
              "fields": ["state"]
            }
          },
          { "filter": "datum.state != null" },
          { "calculate": "replace(datum.state, '_', ' ')", "as": "state_clean" },
          {
            "aggregate": [
              { "op": "sum", "field": "arrivals", "as": "total_arrivals" }
            ],
            "groupby": ["state_clean"]
          },
          
          {
            "calculate": "datum.state_clean + '|' + Year",
            "as": "join_key"
          },

          { "calculate": "Year", "as": "selYear" },
          
          {
            "lookup": "join_key",
            "from": {
              "data": { "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/population_state_agg.csv" },
              "key": "join_key",
              "fields": ["population", "year"]
            }
          },
          { "filter": "datum.population != null" },
          {
            "calculate": "datum.total_arrivals / datum.population",
            "as": "arrivals_per_1000"
          },
          {
            "lookup": "state_clean",
            "from": {
              "data": {
                "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/output.json",
                "format": { "type": "topojson", "feature": "my" }
              },
              "key": "properties.name"
            },
            "as": "geo"
          },
          { "filter": "datum.geo != null" }
      ],

      "mark": { "type": "geoshape", "stroke": "#a9a9a9" },

      "encoding": {
        "shape": { "field": "geo", "type": "geojson" },
        "color": {
          "field": "arrivals_per_1000",
          "type": "quantitative",
          "scale": { "scheme": "tealblues" },
          "title": ["Arrivals per", "1000 Residents"],
          "legend": { "format": ",.0f", "padding": 10 }
        },
        "tooltip": [
          { "field": "state_clean", "title": "State" },
          { "field": "selYear", "title": "Year" },
          { "field": "total_arrivals", "type": "quantitative", "title": "Total Arrivals", "format": "," },
          { "field": "population", "type": "quantitative", "title": "Population (Thousands)", "format": ",.2f" },
          { "field": "arrivals_per_1000", "type": "quantitative", "title": "Arrivals per 1000 Residents", "format": ",.2f" }
        ]
      }
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16,
      "labelLimit": 100
    },
    "legend": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
