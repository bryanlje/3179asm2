{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "background": "transparent",
  "padding": { "left": 0, "right": 0, "top": 10, "bottom": 10 },
  "projection": { "type": "mercator" },
  "view": { "fill": "transparent", "stroke": "transparent" },
  "params": [
    {
      "name": "Year",
      "value": "2020"
    }
  ],

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/output.json",
        "format": { "type": "topojson", "feature": "ne_110m_graticules_1" }
      },
      "mark": { "type": "geoshape", "stroke": "#d1d1d1", "strokeWidth": 0.5 }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/output.json",
        "format": { "type": "topojson", "feature": "my" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#a9a9a9",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/poe_without_country.csv",
        "format": { "type": "csv", "parse": { "date": "date" } }
      },
      "transform": [
        {
          "calculate": "year(toDate(datum.date))",
          "as": "year"
        },
        {
          "filter": "Year === 'All Years' || datum.year == Year"
        },
        {
          "aggregate": [
            { "op": "sum", "field": "arrivals", "as": "arrivals_total" }
          ],
          "groupby": ["poe"]
        },
        { "calculate": "Year", "as": "selYear" },
        {
          "lookup": "poe",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/bryanlje/3179asm2/main/data/points_of_entry.csv",
              "format": {
                "type": "csv",
                "parse": { "lat": "number", "long": "number" }
              }
            },
            "key": "poe",
            "fields": ["lat", "long", "type", "state", "abb", "iso"]
          }
        },
        { "filter": "isValid(datum.lat) && isValid(datum.long)" }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },

      "encoding": {
        "longitude": { "field": "long", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "size": {
          "field": "arrivals_total",
          "type": "quantitative",
          "title": "Arrivals",
          "scale": { 
            "type": "sqrt", 
            "range": [30, 1200],
            "domain": [0, 8000000]
          },
          "legend": {
            "orient": "none",
            "legendX": 200,
            "legendY": 35,
            "direction": "horizontal",
            "titleAnchor": "middle",
            "labelBaseline": "middle",
            "symbolOffset": 8,
            "symbolFillColor": "#a3a3a3"
          }
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "title": "Mode of Entry",
          "scale": {
            "domain": ["Land", "Air", "Sea"],
            "range": ["#E69F00", "#3da7d4", "#009E73"]
          },
          "legend": {
            "orient": "none",
            "legendX": 850,
            "legendY": 250,
            "symbolSize": 400,
            "titlePadding": 8
          }
        },
        "tooltip": [
          { "field": "poe", "title": "Point of Entry" },
          { "field": "state", "title": "State" },
          { "field": "type", "title": "Mode" },
          { "field": "selYear", "title": "Year" },
          {
            "field": "arrivals_total",
            "type": "quantitative",
            "title": "Arrivals",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "view": { "stroke": null },
    "axis": {
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    },
    "legend": {
      "orient": "top",
      "labelColor": "black",
      "titleColor": "black",
      "labelFontSize": 16,
      "titleFontSize": 16
    }
  }
}
